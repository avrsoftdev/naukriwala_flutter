rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // 🏢 Company Logos by Recruiters
    match /company_logos/{recruiterId}/{fileName} {
      allow read: if true; // Public read for company logos
      allow write: if request.resource.size < 2 * 1024 * 1024 && // 2MB limit
                   (request.resource.contentType == 'image/png' ||
                    request.resource.contentType == 'image/jpeg' ||
                    request.resource.contentType == 'image/jpg');
    }

    // 🧑‍💼 Seeker Profile Photos
    match /seeker_photos/{seekerId}/{fileName} {
      allow read: if true; // Public read for profile photos
      allow write: if request.resource.size < 2 * 1024 * 1024 && // 2MB limit
                   (request.resource.contentType == 'image/png' ||
                    request.resource.contentType == 'image/jpeg' ||
                    request.resource.contentType == 'image/jpg');
    }

    // 🌐 Public Uploads (No Authentication Required)
    match /public_uploads/{allPaths=**} {
      allow read: if true; // Public read
      allow write: if request.resource.size < 2 * 1024 * 1024 && // 2MB limit
                   (request.resource.contentType == 'image/png' ||
                    request.resource.contentType == 'image/jpeg' ||
                    request.resource.contentType == 'image/jpg');
    }

    // 📄 Seeker Resumes
    match /seeker_resumes/{seekerId}/resume.pdf {
      allow read: if true; // Public read for resumes (recruiters need access)
      allow write: if request.auth != null &&
                   request.auth.uid == seekerId &&
                   request.resource.size < 5 * 1024 * 1024 && // 5MB limit
                   request.resource.contentType == 'application/pdf';
    }

    // 🔒 Default Deny
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
