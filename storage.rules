rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // 🏢 Company Logos by Recruiters
    match /company_logos/{recruiterId}/logo.png {
      allow read: if true; // Public read for company logos
      allow write: if request.auth != null &&
                   request.auth.uid == recruiterId &&
                   request.auth.token.role == 'recruiter' &&
                   request.resource.size < 2 * 1024 * 1024 && // 2MB limit
                   request.resource.contentType.matches('image/.*');
    }

    // 🧑‍💼 Seeker Profile Photos
    match /seeker_photos/{seekerId}/photo.png {
      allow read: if true; // Public read for profile photos
      allow write: if request.auth != null &&
                   request.auth.uid == seekerId &&
                   request.auth.token.role == 'seeker' &&
                   request.resource.size < 2 * 1024 * 1024 && // 2MB limit
                   request.resource.contentType.matches('image/.*');
    }

    // 📄 Seeker Resumes
    match /seeker_resumes/{seekerId}/resume.pdf {
      allow read: if true; // Public read for resumes (recruiters need access)
      allow write: if request.auth != null &&
                   request.auth.uid == seekerId &&
                   request.auth.token.role == 'seeker' &&
                   request.resource.size < 5 * 1024 * 1024 && // 5MB limit
                   request.resource.contentType == 'application/pdf';
    }

    // 🔒 Default Deny
    match /{path=**} {
      allow read, write: if false;
    }
  }
}