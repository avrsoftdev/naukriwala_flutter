rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
       match /resumes/{jobId}/{seekerId}/{fileName} {
  allow read: if request.auth != null && request.auth.uid == seekerId;
  allow write: if request.auth != null &&
                request.auth.uid == seekerId &&
                request.resource.size < 5 * 1024 * 1024 &&
                request.resource.contentType.matches('application/pdf');
}
    match /company_logos/{recruiterId}/logo.png {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == recruiterId && request.resource.size < 2 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }
    match /seeker_photos/{seekerId}/photo.png {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == seekerId && request.resource.size < 2 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }
    match /{path=**} {
      allow read, write: if false;
    }
  }
}