rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 🔐 Admin check
    function isAdmin() {
      return request.auth.token.admin == true;
    }

    // 👤 Recruiter Profiles
    match /Recruiters/{uid} {
      allow read, write: if request.auth.uid == uid || isAdmin();
    }

    // 👤 Seeker Profiles
    match /Seekers/{uid} {
      allow read: if request.auth.uid == uid || isAdmin() ||
        exists(/databases/$(database)/documents/Applications/$(request.resource.data.jobId)/AppliedJobs/$(uid)) &&
        get(/databases/$(database)/documents/Applications/$(request.resource.data.jobId)).data.recruiterId == request.auth.uid;
      allow write: if request.auth.uid == uid || isAdmin();
    }

    // 📥 FCM and Index
    match /UsersIndex/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == uid || isAdmin();
    }

    // 📄 Recruiter Jobs
    match /Recruiters/{recruiterId}/Jobs/{jobId} {
      allow read: if true; // Anyone can browse jobs
      allow create: if request.auth != null &&
        (request.auth.token.role == 'recruiter' || isAdmin()) &&
        request.resource.data.recruiterId == request.auth.uid;
      allow update: if request.auth != null &&
        (request.auth.token.role == 'recruiter' || isAdmin()) &&
        request.auth.uid == resource.data.recruiterId;
      allow delete: if false; // Protect job history
    }

    // 🌍 Enable job group query
    match /{any=**}/Jobs/{jobId} {
      allow read: if resource.data.status == "open" && request.auth != null;
    }

    // 📄 Applications
    match /Applications/{jobId} {
      allow read: if request.auth != null &&
        (get(/databases/$(database)/documents/Recruiters/$(request.auth.uid)/Jobs/$(jobId)).data.recruiterId == request.auth.uid || isAdmin());
      allow write: if false; // Parent document is read-only for recruiters
    }

    match /Applications/{jobId}/AppliedJobs/{seekerId} {
      allow write: if request.auth.uid == seekerId &&
        request.resource.data.seekerId == seekerId &&
        request.resource.data.jobId == jobId;
      allow read: if request.auth.uid == seekerId || (
        request.auth.token.role == "recruiter" &&
        get(/databases/$(database)/documents/Applications/$(jobId)).data.recruiterId == request.auth.uid
      ) || isAdmin();
      // Allow collection group query for recruiters
      allow read: if request.auth.token.role == "recruiter" &&
        get(/databases/$(database)/documents/Applications/$(jobId)).data.recruiterId == request.auth.uid;
    }

    // 📄 Applications (collection group support with order by)
    match /{path=**}/AppliedJobs/{seekerId} {
      allow read: if request.auth != null && (
        request.auth.uid == seekerId || // Seeker can read their own applications
        (get(/databases/$(database)/documents/AppliedJobs/$(path)/$(seekerId)).data.recruiterId == request.auth.uid) ||
        isAdmin()
      );
      allow write: if request.auth.uid == seekerId &&
        request.resource.data.seekerId == seekerId &&
        request.resource.data.jobId == get(/databases/$(database)/documents/AppliedJobs/$(path)/$(seekerId)).data.jobId;
    }

    // ⭐ Bookmarks
    match /Bookmarks/{uid}/SavedJobs/{jobId} {
      allow read, write: if request.auth.uid == uid || isAdmin();
    }

    // 🔔 Notifications
    match /Notifications/{notifId} {
      allow read, delete: if request.auth.uid == resource.data.to || isAdmin();
      allow create: if request.auth != null &&
        request.resource.data.to != null &&
        request.resource.data.from == request.auth.uid;
      allow update: if request.auth.uid == resource.data.to || isAdmin();
    }

    // 🚫 Fallback
    match /{document=**} {
      allow read, write: if false;
    }
  }
}