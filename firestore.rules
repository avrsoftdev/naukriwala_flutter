rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions (unchanged)
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }
    function isRecruiter() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/Recruiters/$(request.auth.uid));
    }
    function isSeeker() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/Seekers/$(request.auth.uid));
    }
    function isRecruiterJob(jobId) {
      return isRecruiter() &&
             exists(/databases/$(database)/documents/Recruiters/$(request.auth.uid)/Jobs/$(jobId)) &&
             get(/databases/$(database)/documents/Recruiters/$(request.auth.uid)/Jobs/$(jobId)).data.recruiterId == request.auth.uid;
    }
    function isValidRecipient(recipientId) {
      return exists(/databases/$(database)/documents/UsersIndex/$(recipientId));
    }
    function isValidChatParticipant(chatId) {
      let ids = chatId.split('_');
      return request.auth != null &&
             (request.auth.uid == ids[0] || request.auth.uid == ids[1]) &&
             isValidRecipient(ids[0]) &&
             isValidRecipient(ids[1]);
    }
    // Recruiters rule (unchanged)
    match /Recruiters/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow get: if request.auth != null && isSeeker() &&
                 exists(/databases/$(database)/documents/Messages/$(request.auth.uid + '_' + uid)) &&
                 resource.data.keys().hasAll(['name', 'companyName']);
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    // Unchanged collections
    match /Seekers/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /UsersIndex/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /Users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /Recruiters/{recruiterId}/Jobs/{jobId} {
      // Supports isFeatured field for Featured Jobs functionality
      allow read: if request.auth != null;
      allow write: if isRecruiter() && request.auth.uid == recruiterId;
      allow delete: if isRecruiter() && request.auth.uid == recruiterId;
    }
    match /{any=**}/Jobs/{jobId} {
      allow read: if request.auth != null;
    }
    match /RecruiterNotifications/{recruiterId}/Notifications/{notifId} {
      allow read: if request.auth != null && request.auth.uid == recruiterId;
      allow create: if request.auth != null &&
                     request.auth.uid != recruiterId &&
                     isSeeker() &&
                     request.resource.data.to == recruiterId &&
                     isValidRecipient(recruiterId) &&
                     request.resource.data.jobId is string &&
                     request.resource.data.notificationId == notifId &&
                     request.resource.data.type is string &&
                     request.resource.data.read is bool &&
                     request.resource.data.from == request.auth.uid &&
                     request.resource.data.timestamp is timestamp &&
                     exists(/databases/$(database)/documents/Applications/$(request.auth.uid + '_' + request.resource.data.jobId));
      allow update: if request.auth != null &&
                      request.auth.uid == recruiterId &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if request.auth != null && request.auth.uid == recruiterId;
      allow create: if request.auth == null &&
                     request.resource.data.to == recruiterId &&
                     request.resource.data.jobId is string &&
                     request.resource.data.notificationId == notifId &&
                     request.resource.data.type is string &&
                     request.resource.data.read is bool &&
                     request.resource.data.timestamp is timestamp &&
                     isValidRecipient(recruiterId);
    }
    match /SeekerNotifications/{seekerId}/Notifications/{notifId} {
      allow read: if request.auth != null && request.auth.uid == seekerId;
      allow create: if request.auth != null &&
                      request.auth.uid != seekerId &&
                      isRecruiter() &&
                      request.resource.data.to == seekerId &&
                      isValidRecipient(seekerId) &&
                      request.resource.data.jobId is string &&
                      request.resource.data.notificationId == notifId &&
                      request.resource.data.type is string &&
                      request.resource.data.read is bool &&
                      request.resource.data.from == request.auth.uid &&
                      request.resource.data.timestamp is timestamp &&
                      exists(/databases/$(database)/documents/Applications/$(seekerId + '_' + request.resource.data.jobId));
      allow update: if request.auth != null &&
                      request.auth.uid == seekerId &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if request.auth != null &&
                      (request.auth.uid == seekerId ||
                       (request.resource.data.jobId != null &&
                        isRecruiterJob(request.resource.data.jobId)));
      allow create: if request.auth == null &&
                     request.resource.data.to == seekerId &&
                     request.resource.data.jobId is string &&
                     request.resource.data.notificationId == notifId &&
                     request.resource.data.type is string &&
                     request.resource.data.read is bool &&
                     request.resource.data.timestamp is timestamp &&
                     isValidRecipient(seekerId);
    }
    match /{path=**}/Notifications/{notifId} {
      allow read: if request.auth != null &&
                    (request.auth.uid == resource.data.recipientId ||
                     request.auth.uid == resource.data.to);
      allow create: if request.auth != null &&
                     request.resource.data.to != request.resource.data.from &&
                     request.resource.data.jobId is string &&
                     request.resource.data.notificationId == notifId &&
                     request.resource.data.type is string &&
                     request.resource.data.read is bool &&
                     request.resource.data.timestamp is timestamp &&
                     isValidRecipient(request.resource.data.to);
      allow update: if request.auth != null &&
                      (request.auth.uid == resource.data.recipientId ||
                       request.auth.uid == resource.data.to) &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if request.auth != null &&
                      (request.auth.uid == resource.data.recipientId ||
                       request.auth.uid == resource.data.to ||
                       (resource.data.jobId != null &&
                        isRecruiterJob(resource.data.jobId)));
    }
    match /Shortlisted/{jobId}/Seekers/{seekerId} {
      allow read, write: if isRecruiter() && isRecruiterJob(jobId);
    }
    match /Messages/{chatId} {
      allow read: if request.auth != null &&
                    isValidChatParticipant(chatId);
      allow create: if request.auth != null &&
                    request.auth.uid == request.resource.data.senderId &&
                    isValidChatParticipant(chatId) &&
                    request.resource.data.recipientId == (chatId.split('_')[0] == request.auth.uid ? chatId.split('_')[1] : chatId.split('_')[0]) &&
                    request.resource.data.message is string &&
                    request.resource.data.timestamp is timestamp &&
                    request.resource.data.jobId is string;
      allow update: if request.auth != null &&
                    isValidChatParticipant(chatId) &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'timestamp']);
      match /Chats/{messageId} {
        allow read: if request.auth != null &&
                    isValidChatParticipant(chatId);
        allow create: if request.auth != null &&
                      request.auth.uid == request.resource.data.senderId &&
                      isValidChatParticipant(chatId) &&
                      request.resource.data.recipientId == (chatId.split('_')[0] == request.auth.uid ? chatId.split('_')[1] : chatId.split('_')[0]) &&
                      request.resource.data.message is string &&
                      request.resource.data.timestamp is timestamp &&
                      request.resource.data.jobId is string;
        allow update: if request.auth != null &&
                      isValidChatParticipant(chatId) &&
                      request.auth.uid == resource.data.recipientId &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
                      resource.data.status != 'read' &&
                      request.resource.data.status == 'read';
      }
    }
    match /Bookmarks/{uid}/SavedJobs/{jobId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /Applications/{applicationId} {
      allow read: if request.auth != null &&
                    (
                      resource == null ||
                      request.auth.uid == resource.data.seekerId ||
                      (isRecruiter() && (
                        isRecruiterJob(resource.data.jobId) ||
                        resource.data.recruiterId == request.auth.uid
                      )) ||
                      isAdmin()
                    );
      allow create: if isSeeker() &&
                      request.auth.uid == request.resource.data.seekerId &&
                      request.resource.data.jobId is string &&
                      request.resource.data.recruiterId is string &&
                      request.resource.data.status == 'Applied' &&
                      request.resource.data.appliedAt is timestamp &&
                      request.resource.data.jobTitle is string &&
                      request.resource.data.company is string &&
                      request.resource.data.coverLetter is string &&
                      applicationId == request.resource.data.seekerId + '_' + request.resource.data.jobId &&
                      exists(/databases/$(database)/documents/Recruiters/$(request.resource.data.recruiterId)/Jobs/$(request.resource.data.jobId));
      allow update: if isRecruiter() &&
                      isRecruiterJob(resource.data.jobId) &&
                      request.resource.data.seekerId == resource.data.seekerId &&
                      request.resource.data.jobId == resource.data.jobId &&
                      request.resource.data.recruiterId == resource.data.recruiterId &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'interviewDate', 'updatedAt']);
      allow delete: if isRecruiter() && isRecruiterJob(resource.data.jobId);
    }
    match /{path=**}/AppliedJobs/{docId} {
      allow read: if request.auth != null &&
                    isRecruiter() &&
                    resource.data.recruiterId == request.auth.uid;
      allow write: if request.auth != null &&
                     isRecruiter() &&
                     request.resource.data.recruiterId == request.auth.uid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}