rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 🔐 Helper: Admin check
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // 🔐 Helper: Recruiter check
    function isRecruiter() {
      return request.auth != null && request.auth.token.role == "recruiter";
    }

    // 🔐 Helper: Seeker check
    function isSeeker() {
      return request.auth != null && request.auth.token.role == "seeker";
    }

    // ✅ Recruiter can view a seeker if ApplicationsIndex entry exists
    function canRecruiterViewSeeker(seekerId) {
      return isRecruiter() &&
             exists(/databases/$(database)/documents/ApplicationsIndex/$(request.auth.uid + "_" + seekerId));
    }

    // 👤 Seeker Profiles
    match /Seekers/{uid} {
      allow read: if request.auth != null && (
        request.auth.uid == uid || 
        isAdmin() ||
        canRecruiterViewSeeker(uid)
      );
      allow write: if request.auth != null && (
        request.auth.uid == uid || isAdmin()
      );
    }

    // 🧑‍💼 Recruiter Profiles
    match /Recruiters/{uid} {
      allow read, write: if request.auth != null && (
        request.auth.uid == uid || isAdmin()
      );
    }

    // 💼 Jobs Collection (Created by Recruiters)
    match /Jobs/{jobId} {
      allow read: if request.auth != null; // All authenticated users can see jobs
      allow write: if request.auth != null && (
        isRecruiter() || isAdmin()
      );
    }

    // 📄 Job Applications
    match /Applications/{applicationId} {
      allow create: if request.auth != null && isSeeker();
      allow read: if request.auth != null && (
        isAdmin() ||
        // seeker can view their own application
        resource.data.seekerId == request.auth.uid ||
        // recruiter can view if it's their job
        resource.data.recruiterId == request.auth.uid
      );
      allow update, delete: if isAdmin();
    }

    // 🔍 ApplicationsIndex: Recruiter ↔ Seeker View Auth
    match /ApplicationsIndex/{docId} {
      allow read, write: if isRecruiter() || isAdmin();
    }

    // 📦 Optional: Notifications or Chat
    match /Notifications/{notificationId} {
      allow read, write: if request.auth != null;
    }

    match /Chats/{chatId} {
      allow read, write: if request.auth != null;
    }

    // 🚫 Default fallback — deny everything
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
