rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }
    function isRecruiter() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/Recruiters/$(request.auth.uid));
    }
    function isSeeker() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/Seekers/$(request.auth.uid));
    }
    function canRecruiterViewSeeker(seekerId) {
      return isRecruiter() &&
             (
               exists(/databases/$(database)/documents/ApplicationsIndex/$(seekerId + "_" + request.resource.data.jobId)) ||
               exists(/databases/$(database)/documents/Applications/{jobId}/AppliedJobs/$(seekerId))
             );
    }
    function isRecruiterJob(jobId) {
      return isRecruiter() &&
             exists(/databases/$(database)/documents/Recruiters/$(request.auth.uid)/Jobs/$(jobId)) &&
             get(/databases/$(database)/documents/Recruiters/$(request.auth.uid)/Jobs/$(jobId)).data.recruiterId == request.auth.uid;
    }
    function canUpdateApplicationStatus(jobId, seekerId) {
      return isRecruiterJob(jobId) &&
             exists(/databases/$(database)/documents/Applications/$(jobId)/AppliedJobs/$(seekerId)) &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'interviewDate']);
    }
    match /Recruiters/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin() || isSeeker());
      allow write: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }
    match /Seekers/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin() || canRecruiterViewSeeker(uid));
      allow create: if request.auth != null &&
                    request.auth.uid == uid &&
                    request.resource.data.uid == uid &&
                    request.resource.data.role == 'seeker';
      allow update: if request.auth != null && 
                    (request.auth.uid == uid || isAdmin()) &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      'name', 'skills', 'education', 'experience', 'specialization', 
                      'currentCompany', 'currentCtc', 'expectedCtc', 'photoUrl', 'updatedAt'
                    ]);
    }
    match /UsersIndex/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }
    match /Recruiters/{recruiterId}/Jobs/{jobId} {
      allow read: if true;
      allow create: if isRecruiter() &&
                    request.auth.uid == recruiterId &&
                    request.resource.data.recruiterId == request.auth.uid;
      allow update: if isRecruiter() &&
                    request.auth.uid == recruiterId &&
                    request.auth.uid == resource.data.recruiterId;
      allow delete: if false;
    }
    match /{any=**}/Jobs/{jobId} {
      allow read: if request.auth != null && resource.data.status == "open";
    }
    match /Applications/{jobId} {
      allow read: if request.auth != null &&
                  (
                    isSeeker() ||
                    (isRecruiter() &&
                     exists(/databases/$(database)/documents/Recruiters/$(request.auth.uid)/Jobs/$(jobId)) &&
                     get(/databases/$(database)/documents/Recruiters/$(request.auth.uid)/Jobs/$(jobId)).data.recruiterId == request.auth.uid) ||
                    isAdmin()
                  );
      allow create, update: if request.auth != null &&
                             (isSeeker() || isRecruiter()) &&
                             request.resource.data.keys().hasOnly(['recruiterId', 'createdAt']);
    }
    match /Applications/{seekerUid} {
      allow read: if request.auth != null &&
                  (request.auth.uid == seekerUid || isAdmin());
      allow create, update: if isSeeker() &&
                            request.auth.uid == seekerUid &&
                            request.resource.data.keys().hasOnly(['seekerId', 'createdAt']) &&
                            request.resource.data.seekerId == seekerUid;
    }
    match /Applications/{jobId}/AppliedJobs/{docId} {
      allow create: if isSeeker() &&
                    request.auth.uid == request.resource.data.seekerId &&
                    request.resource.data.jobId == jobId &&
                    docId == request.auth.uid;
      allow read: if request.auth != null &&
                    (
                      request.auth.uid == resource.data.seekerId ||
                      (isRecruiter() &&
                       exists(/databases/$(database)/documents/Recruiters/$(request.auth.uid)/Jobs/$(jobId)) &&
                       get(/databases/$(database)/documents/Recruiters/$(request.auth.uid)/Jobs/$(jobId)).data.recruiterId == request.auth.uid) ||
                      isAdmin()
                    );
      allow update: if isRecruiter() &&
                    request.auth.uid == resource.data.recruiterId &&
                    request.resource.data.keys().hasOnly(['status', 'interviewDate']);
      allow write: if isRecruiter() &&
                   isRecruiterJob(jobId) &&
                   request.resource.data.recruiterId == request.auth.uid;
    }
    match /Applications/{jobId}/AppliedJobs {
      allow read: if request.auth != null &&
                   (
                     isSeeker() ||
                     (isRecruiter() &&
                      exists(/databases/$(database)/documents/Recruiters/$(request.auth.uid)/Jobs/$(jobId)) &&
                      get(/databases/$(database)/documents/Recruiters/$(request.auth.uid)/Jobs/$(jobId)).data.recruiterId == request.auth.uid) ||
                     isAdmin()
                   );
    }
    match /Applications/{seekerUid}/AppliedJobs/{jobId} {
      allow read: if request.auth != null &&
                   request.auth.uid == seekerUid &&
                   isSeeker();
      allow create: if isSeeker() &&
                    request.auth.uid == seekerUid &&
                    request.resource.data.seekerId == seekerUid &&
                    request.resource.data.jobId == jobId;
      allow update: if request.auth != null &&
                    (
                      (request.auth.uid == seekerUid && isSeeker()) ||
                      (isRecruiter() &&
                       request.auth.uid == resource.data.recruiterId &&
                       request.resource.data.keys().hasOnly(['status', 'interviewDate']))
                    );
    }
    match /{any=**}/AppliedJobs/{docId} {
      allow read: if request.auth != null &&
                   (
                     request.auth.uid == resource.data.seekerId ||
                     (isRecruiter() && request.auth.uid == resource.data.recruiterId)
                   );
    }
    match /ApplicationsIndex/{docId} {
      allow read: if request.auth != null &&
                   (
                     isSeeker() ||
                     isRecruiter() ||
                     isAdmin()
                   );
      allow create: if isSeeker() &&
                    request.auth.uid == request.resource.data.seekerId &&
                    request.resource.data.jobId != null &&
                    docId == request.resource.data.seekerId + "_" + request.resource.data.jobId;
      allow update: if false;
    }
    match /RecruiterNotifications/{recruiterId}/Notifications/{notifId} {
      allow read: if request.auth != null && (request.auth.uid == recruiterId || isAdmin());
      allow create: if request.auth != null &&
                    request.resource.data.to == recruiterId &&
                    request.resource.data.from == request.auth.uid &&
                    request.resource.data.type == 'application' &&
                    request.resource.data.jobId is string &&
                    request.resource.data.notificationId == notifId &&
                    request.resource.data.read == false &&
                    request.resource.data.timestamp is timestamp;
      allow update: if request.auth != null && (request.auth.uid == recruiterId || isAdmin()) &&
                    request.resource.data.keys().hasOnly(['read']);
    }
    match /SeekerNotifications/{seekerId}/Notifications/{notifId} {
  allow read: if request.auth != null && (request.auth.uid == seekerId || isAdmin());
  allow create: if isRecruiter() &&
                request.resource.data.to == seekerId &&
                request.resource.data.from == request.auth.uid &&
                request.resource.data.type in ['status_update', 'interview_scheduled'] &&
                request.resource.data.jobId is string &&
                request.resource.data.notificationId == notifId &&
                request.resource.data.read == false &&
                request.resource.data.timestamp is timestamp;
  allow update: if request.auth != null && (request.auth.uid == seekerId || isAdmin()) &&
                request.resource.data.keys().hasOnly(['read']);
}
    match /Notifications/{notifId} {
      allow read, delete: if request.auth != null && (request.auth.uid == resource.data.to || isAdmin());
      allow create: if request.auth != null &&
                    request.resource.data.to != null &&
                    request.resource.data.from == request.auth.uid;
      allow update: if request.auth != null && (request.auth.uid == resource.data.to || isAdmin());
    }
    match /Shortlisted/{jobId}/Seekers/{seekerId} {
      allow read: if request.auth != null && isRecruiterJob(jobId);
      allow create: if isRecruiterJob(jobId);
      allow update: if isRecruiterJob(jobId);
      allow delete: if isRecruiterJob(jobId);
    }
    match /Messages/{chatId} {
      allow read: if request.auth != null && chatId.split('_').hasAny([request.auth.uid]);
      allow create: if request.auth != null &&
                    chatId.split('_').hasAny([request.auth.uid]) &&
                    request.resource.data.senderId == request.auth.uid;
      allow update: if false;
    }
    match /Messages/{chatId}/Messages/{messageId} {
      allow read: if request.auth != null && chatId.split('_').hasAny([request.auth.uid]);
      allow create: if request.auth != null &&
                    chatId.split('_').hasAny([request.auth.uid]) &&
                    request.resource.data.senderId == request.auth.uid;
      allow update: if false;
    }
    match /Bookmarks/{uid}/SavedJobs/{jobId} {
      allow read, write: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}