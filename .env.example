# AdMob Configuration Template
# Copy this file to .env and fill in your actual credentials
# IMPORTANT: .env file should NOT be committed to version control

# Your AdMob App ID (from AdMob console)
ADMOB_APP_ID=ca-app-pub-7682628416837305~6528563797

# Your Banner Ad Unit ID (from AdMob console)
ADMOB_BANNER_UNIT_ID=ca-app-pub-7682628416837305/5508042460

# Your Interstitial Ad Unit ID (optional - from AdMob console)
# ADMOB_INTERSTITIAL_UNIT_ID=ca-app-pub-xxxxxxxxxxxxxxxx/yyyyyyyyyy

# Your Rewarded Ad Unit ID (optional - from AdMob console)
# ADMOB_REWARDED_UNIT_ID=ca-app-pub-xxxxxxxxxxxxxxxx/yyyyyyyyyy

# Set to true for development (shows test ads)
# Set to false for production APK builds (shows real ads)
IS_TEST_MODE=false

# Google Places API key (for address autocomplete on onboarding – India only)
# Enable Places API (and optionally Maps JavaScript API) in Google Cloud Console.
GOOGLE_PLACES_API_KEY=AIzaSyCaS7nyrSNdIF4z1whqheZlfFsw72qQZZI