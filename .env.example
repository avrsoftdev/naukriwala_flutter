# AdMob Configuration Template
# Copy this file to .env and fill in your actual credentials

# Your AdMob App ID (from AdMob console)
ADMOB_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX

# Your Banner Ad Unit ID (from AdMob console)
ADMOB_BANNER_UNIT_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX

# Set to true for development (shows test ads)
# Set to false for production APK builds (shows real ads)
IS_TEST_MODE=true